// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("h_PRISMA_URL")
  directUrl = env("h_URL_NON_POOLING")
}

enum UserRole {
  ADMIN
  SUPERVISOR
  EMPLOYEE
}

model User {
  id        String   @id @default(cuid())
  name      String
  username  String   @unique
  password  String
  role      UserRole @default(EMPLOYEE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bills     Bill[]   @relation("BillCreatedBy")
}

model Customer {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  phone    String?
  bills    Bill[]
  dateUsed DateTime[]
  totalUsed  Int      @default(0)
  memberAccount MemberAccount?
}

enum MemberPackage {
  INDIVIDUAL
  FAMILY
  SPA_HOTEL
}

enum TransactionType {
  DEPOSIT
  DEDUCTION
  RECHARGE
}

model MemberAccount {
  id          Int              @id @default(autoincrement())
  customerId  Int              @unique
  customer    Customer         @relation(fields: [customerId], references: [id])
  package     MemberPackage
  balance     Float            @default(0)
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  transactions MemberTransaction[]
}

model MemberTransaction {
  id              Int             @id @default(autoincrement())
  memberAccountId Int
  memberAccount   MemberAccount   @relation(fields: [memberAccountId], references: [id])
  amount          Float
  type            TransactionType
  billId          Int?            @unique
  bill            Bill?           @relation(fields: [billId], references: [id])
  note            String          @default("")
  dateCreated     DateTime        @default(now())
}

model Bill {
  id          Int      @id @default(autoincrement())
  amount      Float
  dateCreated DateTime @default(now())
  customerId  Int
  customer    Customer @relation(fields: [customerId], references: [id])
  note        String   @default("")
  createdById String?
  createdBy   User?    @relation("BillCreatedBy", fields: [createdById], references: [id])
  memberTransaction MemberTransaction?
}

model FixedExpense {
  id          Int      @id @default(autoincrement())
  amount      Float
  month       Int
  year        Int
  dateCreated DateTime @default(now())

  @@unique([month, year])
}
